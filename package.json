{
  "name": "@saigontechnology/vision-camera-background-filter",
  "version": "0.1.0",
  "description": "Real-time selfie background replacement for react-native-vision-camera 5, plus an offline pass that bakes the same look into a recorded file.",
  "source": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "//exports": "`types` and `default` point at SOURCE, not at lib/. `bob build` runs on `prepare` (publish time), so lib/ does not exist while this package is consumed from the workspace — and a `types` condition whose target is missing is not reliably skipped. Some TypeScript versions and editor TS servers fall through to `default` (which is why `tsc` passed), others report the module as untyped, which surfaced as phantom errors in the IDE only. Pointing them at source makes resolution identical in every toolchain. `src` is in `files`, so this holds for the published package too; `import`/`require` still prefer the built output when it exists.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./src/index.ts"
    },
    "./adapters/expo": {
      "source": "./src/adapters/expo.ts",
      "react-native": "./src/adapters/expo.ts",
      "types": "./src/adapters/expo.ts",
      "import": "./lib/module/adapters/expo.js",
      "require": "./lib/commonjs/adapters/expo.js",
      "default": "./src/adapters/expo.ts"
    },
    "./surfaces/expo-camera": {
      "source": "./src/surfaces/ExpoCameraSurface.tsx",
      "react-native": "./src/surfaces/ExpoCameraSurface.tsx",
      "types": "./src/surfaces/ExpoCameraSurface.tsx",
      "import": "./lib/module/surfaces/ExpoCameraSurface.js",
      "require": "./lib/commonjs/surfaces/ExpoCameraSurface.js",
      "default": "./src/surfaces/ExpoCameraSurface.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "specs": "nitrogen --logLevel=\"debug\"",
    "prepare": "bob build"
  },
  "devDependencies": {
    "nitrogen": "0.36.1"
  },
  "keywords": [
    "react-native",
    "vision-camera",
    "background",
    "segmentation",
    "selfie",
    "virtual-background"
  ],
  "license": "MIT",
  "private": true,
  "peerDependencies": {
    "expo-camera": ">=17.0.0",
    "expo-file-system": ">=19.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-nitro-image": ">=0.15.0",
    "react-native-nitro-modules": ">=0.36.0",
    "react-native-vision-camera": ">=5.1.0",
    "react-native-vision-camera-worklets": ">=5.1.0",
    "react-native-worklets": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "expo-camera": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
